DATABASE_URL=postgresql+psycopg2://cybersentinel:cybersentinel@localhost:5432/cybersentinel
REDIS_URL=redis://localhost:6379/0
# Generate a real value with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev-only-insecure-secret-key-change-me-in-production

# Free key: console.groq.com -> API Keys. Only needed for Milestone 2's AI
# features (chat, incident explanation, ...) - the rest of the app runs
# fine without it. Embeddings/RAG search don't need this at all (local
# sentence-transformers model, no API key).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional - only needed for the Slack integration ("Connect to Slack" in
# Settings > Integrations). Create your own app at api.slack.com/apps to
# get these. The rest of the app works fine without them.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# Where a user's browser lands after installing the Slack app, and where
# Slack messages link back to.
FRONTEND_URL=http://localhost:5173

# Optional - the Threat Intel agent falls back to the platform's own local
# indicator table (demo seed + synced feeds like URLhaus) without these, it
# never blocks correlation. Free tiers: virustotal.com (4 req/min,
# 500/day), abuseipdb.com (1,000 checks/day).
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
