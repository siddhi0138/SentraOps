DATABASE_URL=postgresql+psycopg2://cybersentinel:cybersentinel@localhost:5432/cybersentinel
REDIS_URL=redis://localhost:6379/0
# Generate a real value with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev-only-insecure-secret-key-change-me-in-production

# Free key: console.groq.com -> API Keys. Only needed for Milestone 2's AI
# features (chat, incident explanation, ...) - the rest of the app runs
# fine without it. Embeddings/RAG search don't need this at all (local
# sentence-transformers model, no API key).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
